/-- Every list of at most 3 points misses the support of some relation of X4;
equivalently, every 8-subset of the eleven points contains such a support. -/
theorem X4_cover : ∀ V : List Nat, V.length ≤ 3 →
    ∃ r, r ∈ X4rels ∧ ∀ y, y ∈ r.1 :: r.2.1 → y ∉ V := by
  intro V hV
  have ⟨t, ht, htV⟩ := search_spec 3 [] (X4rels.map supp) (by decide +kernel) V hV
    (fun _ _ h => nomatch h)
  have ⟨r, hr, hrt⟩ := mem_map_inv supp t X4rels ht
  exact ⟨r, hr, fun y hy => htV y (hrt ▸ (show y ∈ supp r from hy))⟩

